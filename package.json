{
  "name": "cadenway-api-contracts",
  "version": "0.0.0",
  "description": "Cadenway API contracts: OpenAPI and AsyncAPI specs, and the packages generated from them.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:code": "eslint .",
    "test:lint": "node --test rules/documentation.test.mjs",
    "test:architecture": "node --test tests/architecture/project.test.mjs",
    "lint:specs": "redocly lint \"openapi/**/*.yaml\" \"asyncapi/**/*.yaml\" \"test/redocly/valid/**/*.yaml\"",
    "generate": "orval",
    "generate:events": "modelina generate typescript",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r run build",
    "docs:build": "redocly build-docs",
    "changeset": "changeset",
    "quality": "pnpm format:check && pnpm test:lint && pnpm lint:code && pnpm lint:specs && pnpm generate && pnpm typecheck && pnpm test:architecture && pnpm test && pnpm build",
    "release": "pnpm generate && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/common": "catalog:",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "catalog:",
    "@asyncapi/modelina-cli": "^5.10.1",
    "@cadenway/angular-testing": "0.1.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.70.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "ng-packagr": "^22.2.0",
    "orval": "^8.40.0",
    "prettier": "^3.9.10",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "catalog:"
  }
}
